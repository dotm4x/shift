{
  "name": "@shift/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "shiftc": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "pnpm --filter @shift/compiler build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@shift/compiler": "workspace:*",
    "@shift/project": "workspace:*",
    "commander": "^15.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
