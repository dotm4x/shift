export function add(left: i32, right: i32): i32 {
    return left + right
}

export function subtract(left: i32, right: i32): i32 {
    return left - right
}

export function multiply(left: i32, right: i32): i32 {
    return left * right
}

export function divide(left: i32, right: i32): i32 {
    return left / right
}