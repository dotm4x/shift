{
  "name": "@shift/compiler",
  "version": "0.1.0",
  "private": true,
  "description": "Shift compiler.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
